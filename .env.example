# ==== Servidor ====
PORT=3001
# URL publica HTTPS del servidor, para registrar el webhook con dominio propio (sin ngrok).
# Ej: https://api.tudominio.com  -- la usa `npm run go`. Dejar vacia si usas ngrok (`npm run tunnel`).
PUBLIC_URL=

# ==== Base de datos (PostgreSQL 13+) ====
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASEDATOS?schema=public
DATABASE_URL="postgresql://mototaxi:mototaxi@localhost:5432/mototaxi?schema=public"

# ==== Green API (WhatsApp: grupo SIEMPRE, privado opcional) ====
GREENAPI_API_URL=https://api.green-api.com
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=
GREENAPI_GROUP_CHAT_ID=      # Chat ID del grupo de conductores, termina en @g.us

# ==== Proveedor SOLO del chat privado con el CLIENTE ====
# "greenapi" (por defecto) | "ycloud"
# OJO: el grupo de conductores y el chat privado del CONDUCTOR usan SIEMPRE Green API.
# Pon "ycloud" para que el cliente hable por la API oficial de WhatsApp (requiere credenciales YCLOUD_*).
WHATSAPP_CHATBOT_PROVIDER=greenapi

# ==== YCloud (WhatsApp Cloud API oficial, solo chat privado, opcional) ====
YCLOUD_API_URL=https://api.ycloud.com/v2
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_ACCOUNT_ID=
YCLOUD_WHATSAPP_FROM=
YCLOUD_WEBHOOK_SECRET=

# ==== Google Maps ====
GOOGLE_MAPS_API_KEY=

# ==== Imagen del mototaxi enviada al cliente cuando va en camino (opcional) ====
# Si se deja vacia, usa una imagen por defecto.
IMAGEN_MOTOTAXI_URL=

# ==== Solo para docker-compose (credenciales del contenedor de PostgreSQL) ====
# Si usas docker compose, estas variables crean la BD. La app usa host "db".
POSTGRES_USER=mototaxi
POSTGRES_PASSWORD=mototaxi
POSTGRES_DB=mototaxi
