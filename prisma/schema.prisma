// ==========================================================================
//  Prisma schema - Sistema MotoTaxi (PostgreSQL 13+)
//  Modelo unificado: pedidos + viajesAceptados se fusionan en "Pedido"
//  con la columna "estado" (pendiente | aceptado | finalizado | cancelado).
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoConversacion {
  ninguna              // sin conversacion activa (equivale a null en Firestore)
  esperando_ubicacion  // se le pidio la ubicacion al cliente
}

enum EstadoPedido {
  pendiente
  aceptado
  finalizado
  cancelado
  no_atendido   // expiro sin que ningun conductor lo aceptara
}

enum EstadoConductor {
  disponible
  ocupado
  inactivo
}

// ---- CLIENTES -----------------------------------------------------------
model Cliente {
  telefono     String              @id                         // ID = telefono sin @c.us
  nombre       String?
  conversacion EstadoConversacion  @default(ninguna)
  creadoEn     DateTime            @default(now())
  actualizado  DateTime            @updatedAt

  direcciones  ClienteDireccion[]
  pedidos      Pedido[]

  @@map("clientes")
}

// ---- DIRECCIONES DEL CLIENTE (array embebido -> tabla hija) -------------
model ClienteDireccion {
  id              Int      @id @default(autoincrement())
  clienteTelefono String
  direccion       String
  lat             Float?
  lng             Float?
  mapsUrl         String?
  orden           Int      @default(0)   // 0 = mas reciente (menor = mas nuevo)
  creadoEn        DateTime @default(now())

  cliente Cliente @relation(fields: [clienteTelefono], references: [telefono], onDelete: Cascade)

  @@index([clienteTelefono, orden])
  @@map("cliente_direcciones")
}

// ---- CONDUCTORES (esquema unificado) -----------------------------------
model Conductor {
  phoneFull String          @id                  // ID = telefono completo
  fullName  String
  plate     String?
  unit      String?
  lid       String?  @unique                     // WhatsApp Linked ID (identificador anonimo del grupo)
  fotoUrl   String?                              // ruta publica de la foto (se envia al cliente al aceptar)
  estado    EstadoConductor @default(disponible)
  creadoEn  DateTime        @default(now())
  actualizado DateTime      @updatedAt

  pedidos Pedido[]

  @@map("conductores")
}

// ---- SECTORES (poligonos geograficos) ----------------------------------
model Sector {
  id           String   @id @default(uuid())
  nombreSector String
  coordenadas  Json                                    // [{ lat, lng }, ...] (min 3 puntos)
  creadoEn     DateTime @default(now())
  actualizado  DateTime @updatedAt

  @@map("sectores")
}

// ---- PEDIDOS (unifica pedidos + viajesAceptados) -----------------------
model Pedido {
  id                    String       @id @default(uuid())
  pedidoCode            String       @unique                 // 6 chars MAYUS
  clienteTelefono       String
  clienteNombre         String?

  // Ubicacion (aplanada)
  ubicDescripcion       String?
  ubicDireccionCompleta String?
  ubicLat               Float?
  ubicLng               Float?
  ubicMapsUrl           String?
  sector                String?                              // nombre del sector/poligono donde cae la ubicacion

  estado                EstadoPedido @default(pendiente)

  // Asignacion
  conductorId           String?                              // FK -> Conductor.phoneFull
  conductorData         Json?                                // { fullName, phoneFull, plate, unit }
  minutosEta            Int?

  recordatoriosEnviados Int          @default(0)             // cuantos avisos "seguimos buscando" se enviaron
  republicadoEnGrupo    Boolean      @default(false)         // si ya se reenviaron los botones al grupo

  waGroupMsgId          String?

  creadoEn              DateTime     @default(now())
  aceptadoEn            DateTime?

  cliente   Cliente    @relation(fields: [clienteTelefono], references: [telefono])
  conductor Conductor? @relation(fields: [conductorId], references: [phoneFull])

  @@index([estado])
  @@index([clienteTelefono, estado])
  @@map("pedidos")
}
